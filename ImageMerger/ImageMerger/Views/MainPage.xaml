<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ImageMerger.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:ImageMerger.Helpers"
    xmlns:vm="using:ImageMerger.ViewModels"
    mc:Ignorable="d">

    <!--
        AllowDrop + Background (dù là Transparent) để cả trang nhận được file kéo từ Explorer.
        Không có Background thì vùng trống không "bắt" được chuột/kéo thả.
        Sự kiện DragOver/Drop được đăng ký trong code-behind (xem MainPage.xaml.cs).

        Bố cục: hàng 0 là danh sách trang (chiếm hết chỗ còn lại), hàng 1 là thanh xuất PDF ở đáy.
    -->
    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            AdaptiveTrigger: VisualStateManager tự chuyển trạng thái theo chiều rộng cửa sổ.
            Cửa sổ hẹp (dưới 1100 DIP) thì ô "Tên file" xuống hàng thứ hai của thanh xuất,
            để các nút không bị ép chồng lên nhau. Trạng thái nào có MinWindowWidth lớn nhất mà vẫn thoả thì thắng.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FileNamePanel.(Grid.Row)" Value="1" />
                        <Setter Target="FileNamePanel.(Grid.Column)" Value="0" />
                        <Setter Target="FileNamePanel.(Grid.ColumnSpan)" Value="5" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  ===== Hàng 0: danh sách trang =====  -->
        <Grid Padding="24,0,24,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Tiêu đề + các nút thao tác với danh sách  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Merger" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.PageCountText, Mode=OneWay}"
                        Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.HasItems), Mode=OneWay}" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    Command="{x:Bind ViewModel.AddImagesCommand}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="Thêm ảnh" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.SortByNameCommand}"
                    Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Sort" />
                        <TextBlock Text="Sắp xếp theo tên" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Thêm tuỳ chọn"
                    Content="&#x22EF;"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Thêm tuỳ chọn">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.SortByDateCommand}" Text="Sắp xếp theo ngày sửa" />
                            <MenuFlyoutSeparator />
                            <!--  Xoá hết là thao tác phá huỷ nên hỏi lại bằng ContentDialog (xem OnClearAllClick)  -->
                            <MenuFlyoutItem
                                Click="OnClearAllClick"
                                IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                                Text="Xoá tất cả…">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Delete" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!--  InfoBar chung: cảnh báo file không hỗ trợ khi thêm ảnh  -->
            <InfoBar
                Grid.Row="1"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />

            <!--  Danh sách trống: một vùng thả lớn ở giữa  -->
            <Button
                Grid.Row="2"
                MaxWidth="560"
                MaxHeight="320"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.AddImagesCommand}"
                Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
                <Grid>
                    <Rectangle
                        RadiusX="8"
                        RadiusY="8"
                        Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}"
                        StrokeDashArray="4,3"
                        StrokeThickness="2" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <FontIcon
                            FontSize="48"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xEB9F;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Chưa có ảnh nào" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Bấm để thêm ảnh hoặc kéo thả tệp vào đây" />
                    </StackPanel>
                </Grid>
            </Button>

            <!--
                CanReorderItems + CanDragItems + AllowDrop: ListView tự xử lý kéo thả để đổi thứ tự.
                Khi thả, ListView gọi Remove + Insert trên ObservableCollection, nên ViewModel
                luôn giữ đúng thứ tự mà không cần code thêm.
            -->
            <ListView
                Grid.Row="2"
                AllowDrop="True"
                AutomationProperties.Name="Danh sách ảnh"
                CanDragItems="True"
                CanReorderItems="True"
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectionMode="None"
                Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.HasItems), Mode=OneWay}">
                <ListView.ItemTemplate>
                    <!--  x:DataType cho x:Bind biết kiểu của từng item để kiểm tra lúc compile  -->
                    <DataTemplate x:DataType="vm:ImageItemViewModel">
                        <!--  Background Transparent để PointerEntered/Exited bắt được cả vùng trống của dòng  -->
                        <Grid
                            Padding="0,6"
                            Background="Transparent"
                            ColumnSpacing="12"
                            PointerEntered="OnItemPointerEntered"
                            PointerExited="OnItemPointerExited">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <!--  Rộng 48 để vừa khoảng trang của PDF, ví dụ "12–31"  -->
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                Tay nắm. Cố ý dùng Border thay vì Button: Button "bắt" con trỏ ngay khi nhấn
                                nên ListView không bao giờ nhận được thao tác kéo. Border thì không, nên:
                                - Nhấn giữ rồi kéo lên/xuống: ListView tự đổi thứ tự (CanReorderItems).
                                - Bấm (Tapped, chỉ xảy ra khi không kéo): mở menu, xem OnDragHandleTapped.
                                - Chuột phải: ContextFlyout tự mở cùng menu đó.
                            -->
                            <Border
                                Width="24"
                                Height="40"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Di chuyển"
                                Background="Transparent"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Tapped="OnDragHandleTapped"
                                ToolTipService.ToolTip="Kéo để di chuyển, bấm để mở menu">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE700;" />
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Command="{x:Bind MoveToTopCommand}" Text="Lên đầu">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEDDB;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Command="{x:Bind MoveUpCommand}" Text="Lên 1">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70E;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Command="{x:Bind MoveDownCommand}" Text="Xuống 1">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Command="{x:Bind MoveToBottomCommand}" Text="Xuống cuối">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEDDC;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind PageNumberText, Mode=OneWay}" />

                            <Border
                                Grid.Column="2"
                                Width="72"
                                Height="72"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid>
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                    <ProgressRing
                                        Width="24"
                                        Height="24"
                                        IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind SizeText, Mode=OneWay}" />

                                <!--
                                    Ô chọn trang, chỉ có ở file PDF. Cú pháp giống hộp thoại In ("1-3, 5"), để trống = tất cả.
                                    Bị khoá (IsEnabled) cho tới khi đọc xong PDF. Lỗi hiện bằng dòng chữ đỏ ngay bên dưới.
                                -->
                                <StackPanel
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(IsPdf)}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Trang" />
                                    <TextBox
                                        Width="180"
                                        AutomationProperties.Name="Chọn trang"
                                        IsEnabled="{x:Bind IsPageRangeEnabled, Mode=OneWay}"
                                        PlaceholderText="Tất cả (vd: 1-3, 5)"
                                        Text="{x:Bind PageRangeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind PageRangeError, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(HasPageRangeError), Mode=OneWay}" />
                            </StackPanel>

                            <!--  Opacity 0: chỉ hiện khi rê chuột lên dòng (xem OnItemPointerEntered)  -->
                            <Button
                                x:Name="DeleteButton"
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Xoá ảnh"
                                Command="{x:Bind RemoveCommand}"
                                Opacity="0"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Xoá khỏi danh sách">
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <!--  Footer luôn nằm sau trang cuối: vùng thả viền nét đứt để thêm tiếp  -->
                <ListView.Footer>
                    <Button
                        Margin="0,8,0,0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.AddImagesCommand}">
                        <Grid Height="56">
                            <Rectangle
                                RadiusX="6"
                                RadiusY="6"
                                Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}"
                                StrokeDashArray="4,3"
                                StrokeThickness="1.5" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <SymbolIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Symbol="Add" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Thêm ảnh hoặc kéo thả tệp vào đây" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </ListView.Footer>
            </ListView>
        </Grid>

        <!--  ===== Hàng 1: thanh xuất PDF =====  -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel Padding="24,12" Spacing="12">

                <!--  Kết quả xuất: dung lượng thật so với ước tính, kèm nút Mở file  -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.Export.HasResult, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.Export.ResultMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.Export.ResultSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.Export.ResultTitle, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            Command="{x:Bind ViewModel.Export.OpenResultCommand}"
                            Content="Mở file"
                            Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.CanOpenResult), Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!--  Tuỳ chỉnh: chỉ hiện khi chọn "Tuỳ chỉnh"  -->
                <StackPanel Spacing="4" Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.IsCustom), Mode=OneWay}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            Header="Chất lượng JPEG"
                            Maximum="100"
                            Minimum="1"
                            StepFrequency="1"
                            Value="{x:Bind ViewModel.Export.CustomQuality, Mode=TwoWay}" />
                        <!--  Để trống thì Value = NaN, ViewModel hiểu là "giữ nguyên chiều rộng".  -->
                        <NumberBox
                            Grid.Column="1"
                            MinWidth="200"
                            Header="Chiều rộng tối đa (px)"
                            Maximum="20000"
                            Minimum="64"
                            PlaceholderText="Để trống: giữ nguyên"
                            SmallChange="128"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.Export.CustomMaxWidth, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.Export.ValidationMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.HasValidationError), Mode=OneWay}" />
                </StackPanel>

                <!--
                    Một hàng: Mức nén | Tên file | dung lượng ước tính | Xuất PDF.
                    Hàng thứ hai chỉ dùng khi cửa sổ hẹp (xem NarrowState ở đầu trang).
                -->
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Mức nén" />

                    <!--  Thứ tự item khớp enum CompressionPreset  -->
                    <RadioButtons
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        MaxColumns="4"
                        SelectedIndex="{x:Bind ViewModel.Export.SelectedPresetIndex, Mode=TwoWay}">
                        <x:String>Gốc</x:String>
                        <x:String>Cân bằng</x:String>
                        <x:String>Nhỏ gọn</x:String>
                        <x:String>Tuỳ chỉnh</x:String>
                    </RadioButtons>

                    <!--
                        Tên file. UpdateSourceTrigger=PropertyChanged: đẩy giá trị về ViewModel sau mỗi phím gõ
                        (mặc định TextBox chỉ đẩy khi mất focus), nên lỗi ký tự không hợp lệ hiện ngay.
                    -->
                    <StackPanel
                        x:Name="FileNamePanel"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Tên file" />
                            <TextBox
                                Width="200"
                                AutomationProperties.Name="Tên file"
                                PlaceholderText="{x:Bind ViewModel.Export.DefaultFileName, Mode=OneWay}"
                                Text="{x:Bind ViewModel.Export.FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text=".pdf" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Export.FileNameError, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.HasFileNameError), Mode=OneWay}" />
                    </StackPanel>

                    <!--  Dung lượng ước tính; bấm để xem chi tiết từng mức nén  -->
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Export.EstimatedSizeText, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Export.CompareText, Mode=OneWay}" />
                            </StackPanel>
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.Export.IsEstimating, Mode=OneWay}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <StackPanel MinWidth="300" Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Dung lượng ước tính" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Export.Presets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PresetOptionViewModel">
                                                <Grid Padding="0,4" ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind Name}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Description}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Text="{x:Bind EstimatedSizeText, Mode=OneWay}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Spacing="4" Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.HasEstimate), Mode=OneWay}">
                                        <ProgressBar
                                            AutomationProperties.Name="Tỉ lệ so với ảnh gốc"
                                            Maximum="100"
                                            Value="{x:Bind ViewModel.Export.EstimateRatio, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Sai số thường trong khoảng ±20%" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!--  Nút Xuất PDF; Ctrl+E gọi cùng command  -->
                    <Button
                        Grid.Column="4"
                        MinWidth="120"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.Export.ExportCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.IsNotExporting), Mode=OneWay}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="E" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Save" />
                            <TextBlock Text="Xuất PDF" />
                        </StackPanel>
                    </Button>

                    <!--  Đang xuất: thay nút Xuất bằng tiến độ + Huỷ  -->
                    <StackPanel
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.IsExporting), Mode=OneWay}">
                        <StackPanel Width="180" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Export.ProgressText, Mode=OneWay}" />
                            <ProgressBar
                                AutomationProperties.Name="Tiến độ xuất"
                                Maximum="100"
                                Value="{x:Bind ViewModel.Export.Progress, Mode=OneWay}" />
                        </StackPanel>
                        <Button Command="{x:Bind ViewModel.Export.CancelCommand}" Content="Huỷ" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
