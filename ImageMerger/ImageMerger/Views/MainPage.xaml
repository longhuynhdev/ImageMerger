<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ImageMerger.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:ImageMerger.Helpers"
    xmlns:vm="using:ImageMerger.ViewModels"
    mc:Ignorable="d">

    <!--
        AllowDrop + Background (dù là Transparent) để cả trang nhận được file kéo từ Explorer.
        Không có Background thì vùng trống không "bắt" được chuột/kéo thả.
        Sự kiện DragOver/Drop được đăng ký trong code-behind (xem MainPage.xaml.cs).
    -->
    <Grid
        x:Name="RootGrid"
        Padding="24,0,24,24"
        AllowDrop="True"
        Background="Transparent"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            CommandBar: thanh lệnh chuẩn của WinUI. AppBarButton là nút có icon + nhãn.
            DefaultLabelPosition="Right" hiện nhãn cạnh icon thay vì ẩn đi.
        -->
        <CommandBar
            HorizontalAlignment="Left"
            DefaultLabelPosition="Right"
            Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.HasItems), Mode=OneWay}">
            <AppBarButton
                Command="{x:Bind ViewModel.AddImagesCommand}"
                Icon="Add"
                Label="Thêm ảnh" />

            <!--  AppBarButton có Flyout: bấm vào sẽ mở menu thả xuống (Sắp xếp ▾)  -->
            <AppBarButton Icon="Sort" Label="Sắp xếp">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Command="{x:Bind ViewModel.SortByNameCommand}" Text="Theo tên" />
                        <MenuFlyoutItem Command="{x:Bind ViewModel.SortByDateCommand}" Text="Theo ngày sửa" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <!--  Xoá hết cần xác nhận: Flyout nhỏ với nút xác nhận, nhẹ hơn ContentDialog  -->
            <AppBarButton
                Icon="Delete"
                IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                Label="Xoá hết">
                <AppBarButton.Flyout>
                    <Flyout x:Name="ClearAllFlyout">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Xoá tất cả ảnh khỏi danh sách?" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="File gốc trên máy không bị ảnh hưởng." />
                            <Button
                                Click="OnConfirmClearAllClick"
                                Command="{x:Bind ViewModel.ClearAllCommand}"
                                Content="Xoá hết"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <AppBarSeparator />

            <AppBarButton
                Click="OnExportClick"
                IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
                Icon="Save"
                Label="Xuất ảnh" />
        </CommandBar>

        <!--  InfoBar: thông báo ngay trong trang, không chặn thao tác như hộp thoại  -->
        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />

        <!--
            Thanh tiến độ khi đang xuất. ProgressBar với Maximum=100 hiển thị phần trăm;
            nút Huỷ bind vào ExportCancelCommand, command này huỷ CancellationTokenSource của lần xuất đang chạy.
        -->
        <Grid
            Grid.Row="2"
            ColumnSpacing="16"
            Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.IsExporting), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.ExportingText, Mode=OneWay}" />
            <ProgressBar
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="Tiến độ xuất"
                Maximum="100"
                Value="{x:Bind ViewModel.ExportProgress, Mode=OneWay}" />
            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.ExportCancelCommand}"
                Content="Huỷ" />
        </Grid>

        <!--  Màn hình trống: chỉ hiện khi chưa có ảnh nào  -->
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xEB9F;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Chưa có ảnh nào" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Bấm Thêm ảnh hoặc kéo file từ Explorer vào đây" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.AddImagesCommand}"
                Content="Thêm ảnh"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <!--
            CanReorderItems + CanDragItems + AllowDrop: ListView tự xử lý kéo thả để đổi thứ tự.
            Khi thả, ListView gọi Remove + Insert trên ObservableCollection, nên ViewModel
            luôn giữ đúng thứ tự mà không cần code thêm.
        -->
        <ListView
            Grid.Row="3"
            AllowDrop="True"
            AutomationProperties.Name="Danh sách ảnh"
            CanDragItems="True"
            CanReorderItems="True"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None"
            Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.HasItems), Mode=OneWay}">
            <ListView.ItemTemplate>
                <!--  x:DataType cho x:Bind biết kiểu của từng item để kiểm tra lúc compile  -->
                <DataTemplate x:DataType="vm:ImageItemViewModel">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            Tay cầm. Cố ý dùng Border thay vì Button: Button "bắt" con trỏ ngay khi nhấn
                            nên ListView không bao giờ nhận được thao tác kéo. Border thì không, nên:
                            - Nhấn giữ rồi kéo lên/xuống: ListView tự đổi thứ tự (CanReorderItems).
                            - Bấm (Tapped, chỉ xảy ra khi không kéo): mở menu, xem OnDragHandleTapped.
                            - Chuột phải: ContextFlyout tự mở cùng menu đó.
                        -->
                        <Border
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Di chuyển"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Tapped="OnDragHandleTapped"
                            ToolTipService.ToolTip="Kéo để di chuyển, bấm để mở menu">
                            <FontIcon FontSize="16" Glyph="&#xE76F;" />
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{x:Bind MoveToTopCommand}" Text="Lên đầu">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xEDDB;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind MoveUpCommand}" Text="Lên 1">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70E;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind MoveDownCommand}" Text="Xuống 1">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind MoveToBottomCommand}" Text="Xuống cuối">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xEDDC;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Width="96"
                            Height="96"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <Grid>
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                <ProgressRing
                                    Width="24"
                                    Height="24"
                                    IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind SizeText, Mode=OneWay}" />
                        </StackPanel>

                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Xoá ảnh"
                            Command="{x:Bind RemoveCommand}"
                            ToolTipService.ToolTip="Xoá khỏi danh sách">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
            Nút Thêm ảnh nằm ở hàng Auto riêng, ngoài ListView, nên không cuộn theo danh sách
            mà luôn ghim ở đáy cửa sổ.
        -->
        <Button
            Grid.Row="4"
            Command="{x:Bind ViewModel.AddImagesCommand}"
            Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.HasItems), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Add" />
                <TextBlock Text="Thêm ảnh" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
