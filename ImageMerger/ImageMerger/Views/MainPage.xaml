<?xml version="1.0" encoding="utf-8" ?>
<!--
    Giao diện 3 bước cho người không rành công nghệ:
    1. Thêm ảnh hoặc file PDF   2. Kiểm tra thứ tự trang   3. Lưu thành file PDF.
    Nguyên tắc: chữ to (16), nút cao (44), không có menu ẩn, nút nào cũng có chữ.

    FontSize="16" trên Page: TextBlock trong trang kế thừa cỡ chữ này.
    Các control (Button, TextBox, RadioButton) tự đặt FontSize trong style mặc định nên không kế thừa,
    vì vậy có thêm implicit style bên dưới.
-->
<Page
    x:Class="ImageMerger.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:ImageMerger.Helpers"
    xmlns:vm="using:ImageMerger.ViewModels"
    FontSize="16"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            Implicit style: Style không có x:Key áp dụng cho MỌI control đúng kiểu TargetType trong trang.
            BasedOn giữ nguyên giao diện Fluent mặc định, chỉ đổi cỡ chữ và chiều cao tối thiểu.
            Nút có Style riêng (AccentButtonStyle) không nhận implicit style, nên đặt cỡ chữ trực tiếp trên nút đó.
        -->
        <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style BasedOn="{StaticResource DefaultRadioButtonStyle}" TargetType="RadioButton">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="44" />
        </Style>

        <!--  Tiêu đề bước: vòng tròn có số + chữ to. Ba style dùng chung cho cả 3 bước.  -->
        <Style x:Key="StepCircleStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="StepNumberStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StepTitleStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Chữ phụ (mô tả, hướng dẫn): nhỏ hơn một chút, màu nhạt  -->
        <Style x:Key="HelpTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  Nền màu nhấn rất nhạt cho 2 nút lớn ở bước 1  -->
        <SolidColorBrush
            x:Key="LightAccentBrush"
            Opacity="0.1"
            Color="{ThemeResource SystemAccentColor}" />
        <Style
            x:Key="BigAddButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Background" Value="{StaticResource LightAccentBrush}" />
        </Style>
    </Page.Resources>

    <!--
        AllowDrop + Background (dù là Transparent) để cả trang nhận được file kéo từ Explorer.
        Sự kiện DragOver/Drop được đăng ký trong code-behind (xem MainPage.xaml.cs).

        Bố cục: cột trái (*) là bước 1 và 2, cột phải (400) là bước 3.
    -->
    <Grid
        x:Name="RootGrid"
        Padding="24,8,24,24"
        AllowDrop="True"
        Background="Transparent"
        ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightColumn" Width="400" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            AdaptiveTrigger: VisualStateManager tự chuyển trạng thái theo chiều rộng cửa sổ.
            Cửa sổ hẹp (dưới 920 DIP) thì cột phải (bước 3) xuống dưới cột trái, mỗi phần chiếm nửa chiều cao.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="920" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightColumn.Width" Value="0" />
                        <Setter Target="BottomRow.Height" Value="*" />
                        <Setter Target="RootGrid.ColumnSpacing" Value="0" />
                        <Setter Target="RightPanel.(Grid.Row)" Value="1" />
                        <Setter Target="RightPanel.(Grid.Column)" Value="0" />
                        <Setter Target="RightPanel.Margin" Value="0,16,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  ===== Cột trái: bước 1 và bước 2 =====  -->
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Bước 1  -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{StaticResource StepCircleStyle}">
                    <TextBlock Style="{StaticResource StepNumberStyle}" Text="1" />
                </Border>
                <TextBlock Style="{StaticResource StepTitleStyle}" Text="Thêm ảnh hoặc file PDF" />
            </StackPanel>

            <!--  Hai nút lớn cạnh nhau: thêm ảnh và thêm PDF là hai việc tách bạch  -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Command="{x:Bind ViewModel.AddImagesCommand}" Style="{StaticResource BigAddButtonStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="28"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xEB9F;" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Thêm ảnh" />
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="Ảnh chụp từ điện thoại, máy ảnh: JPG, PNG" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.AddPdfCommand}"
                    Style="{StaticResource BigAddButtonStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="28"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xEA90;" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Thêm file PDF" />
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="Mỗi trang trong file PDF sẽ thành một trang riêng" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <TextBlock
                Grid.Row="2"
                Style="{StaticResource HelpTextStyle}"
                Text="Bạn cũng có thể kéo tệp từ thư mục rồi thả vào cửa sổ này." />

            <!--  Cảnh báo khi có file không phải ảnh/PDF. Nút "Đã hiểu" thay cho nút X nhỏ.  -->
            <InfoBar
                Grid.Row="3"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.DismissStatusCommand}" Content="Đã hiểu" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--  Bước 2  -->
            <StackPanel
                Grid.Row="4"
                Margin="0,12,0,0"
                Orientation="Horizontal"
                Spacing="12">
                <Border Style="{StaticResource StepCircleStyle}">
                    <TextBlock Style="{StaticResource StepNumberStyle}" Text="2" />
                </Border>
                <!--  Run: một đoạn chữ trong TextBlock; x:Bind được vào Run.Text để ghép chữ cố định với số trang.  -->
                <TextBlock Style="{StaticResource StepTitleStyle}">
                    <Run Text="Kiểm tra thứ tự trang (" /><Run Text="{x:Bind ViewModel.PageCountText, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
            </StackPanel>

            <StackPanel
                Grid.Row="5"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{x:Bind ViewModel.SortByNameCommand}" Content="Sắp xếp theo tên" />
                <Button Command="{x:Bind ViewModel.SortByDateCommand}" Content="Sắp xếp theo ngày" />
                <!--  Xoá hết là thao tác phá huỷ nên hỏi lại bằng ContentDialog (xem OnClearAllClick)  -->
                <Button
                    Click="OnClearAllClick"
                    Content="Xoá tất cả"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}" />
            </StackPanel>

            <!--  Danh sách trống: khung viền nét đứt có lời nhắc  -->
            <Grid
                Grid.Row="6"
                MinHeight="160"
                VerticalAlignment="Top"
                Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
                <Rectangle
                    RadiusX="8"
                    RadiusY="8"
                    Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}"
                    StrokeDashArray="4,3"
                    StrokeThickness="2" />
                <TextBlock
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Chưa có trang nào. Bấm “Thêm ảnh” hoặc “Thêm file PDF” ở bước 1."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Grid>

            <!--
                Mỗi dòng có nút "Lên", "Xuống", "Xoá" luôn hiện: không cần biết kéo thả.
                CanReorderItems vẫn bật để ai quen kéo thả thì vẫn dùng được.
                Nút trong dòng của ListView hoạt động như nút bình thường; Command của từng nút
                bind vào command của chính item đó (x:DataType=ImageItemViewModel).
            -->
            <ListView
                Grid.Row="6"
                AllowDrop="True"
                AutomationProperties.Name="Danh sách trang"
                CanDragItems="True"
                CanReorderItems="True"
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectionMode="None"
                Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.HasItems), Mode=OneWay}">
                <ListView.ItemTemplate>
                    <!--  x:DataType cho x:Bind biết kiểu của từng item để kiểm tra lúc compile  -->
                    <DataTemplate x:DataType="vm:ImageItemViewModel">
                        <Grid Padding="0,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind PageNumberText, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <Border
                                Grid.Column="1"
                                Width="96"
                                Height="72"
                                VerticalAlignment="Center"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid>
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                    <ProgressRing
                                        Width="24"
                                        Height="24"
                                        IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource HelpTextStyle}" Text="{x:Bind SizeText, Mode=OneWay}" />

                                <!--
                                    Ô chọn trang, chỉ có ở file PDF. Cú pháp giống hộp thoại In ("1-3, 5"), để trống = tất cả.
                                    Bị khoá (IsEnabled) cho tới khi đọc xong PDF. Lỗi hiện bằng dòng chữ đỏ ngay bên dưới.
                                -->
                                <StackPanel
                                    Margin="0,6,0,0"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(IsPdf)}">
                                    <TextBlock Style="{StaticResource HelpTextStyle}" Text="Chỉ lấy một số trang (để trống là lấy tất cả):" />
                                    <TextBox
                                        MaxWidth="240"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Chọn trang"
                                        IsEnabled="{x:Bind IsPageRangeEnabled, Mode=OneWay}"
                                        PlaceholderText="Ví dụ: 1-3, 5"
                                        Text="{x:Bind PageRangeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Style="{StaticResource ErrorTextStyle}"
                                        Text="{x:Bind PageRangeError, Mode=OneWay}"
                                        Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(HasPageRangeError), Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Nút luôn hiện, có chữ. Lên mờ ở dòng đầu, Xuống mờ ở dòng cuối (CanExecute).  -->
                            <StackPanel
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button Command="{x:Bind MoveUpCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE74A;" />
                                        <TextBlock Text="Lên" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind MoveDownCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE74B;" />
                                        <TextBlock Text="Xuống" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind RemoveCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        <TextBlock Text="Xoá" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  ===== Cột phải: bước 3 =====  -->
        <Border
            x:Name="RightPanel"
            Grid.Column="1"
            Padding="20"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Phần trên cuộn được; nút Lưu ở hàng dưới luôn nhìn thấy  -->
                <ScrollViewer Padding="0,0,12,0">
                    <StackPanel Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource StepCircleStyle}">
                                <TextBlock Style="{StaticResource StepNumberStyle}" Text="3" />
                            </Border>
                            <TextBlock Style="{StaticResource StepTitleStyle}" Text="Lưu thành file PDF" />
                        </StackPanel>

                        <!--
                            Tên file. UpdateSourceTrigger=PropertyChanged: đẩy giá trị về ViewModel sau mỗi phím gõ
                            (mặc định TextBox chỉ đẩy khi mất focus), nên lỗi ký tự không hợp lệ hiện ngay.
                        -->
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Tên file" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    AutomationProperties.Name="Tên file"
                                    FontSize="17"
                                    PlaceholderText="{x:Bind ViewModel.Export.DefaultFileName, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.Export.FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="17"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text=".pdf" />
                            </Grid>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="{x:Bind ViewModel.Export.FileNameHelpText, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource ErrorTextStyle}"
                                Text="{x:Bind ViewModel.Export.FileNameError, Mode=OneWay}"
                                Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.HasFileNameError), Mode=OneWay}" />
                        </StackPanel>

                        <!--
                            Kích thước file: RadioButtons lấy item từ ViewModel.Export.Presets, ItemTemplate vẽ nội dung
                            mỗi nút. SelectedIndex = -1 khi đang dùng tuỳ chỉnh nâng cao (không nút nào được chọn).
                        -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Kích thước file" />
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind ViewModel.Export.IsEstimating, Mode=OneWay}" />
                            </StackPanel>
                            <RadioButtons ItemsSource="{x:Bind ViewModel.Export.Presets}" SelectedIndex="{x:Bind ViewModel.Export.SelectedPresetIndex, Mode=TwoWay}">
                                <RadioButtons.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PresetOptionViewModel">
                                        <Grid MinWidth="290" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock FontSize="17" Text="{x:Bind Name}" />
                                                    <Border
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(IsRecommended)}">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            Text="Nên chọn" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource HelpTextStyle}" Text="{x:Bind Description}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Text="{x:Bind EstimatedSizeText, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </RadioButtons.ItemTemplate>
                            </RadioButtons>
                            <TextBlock
                                Style="{StaticResource HelpTextStyle}"
                                Text="{x:Bind ViewModel.Export.CustomSummaryText, Mode=OneWay}"
                                Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.IsCustom), Mode=OneWay}" />
                        </StackPanel>

                        <!--
                            Expander: khung gập/mở có tiêu đề. Mặc định gập lại (IsExpanded="False")
                            để người dùng thường không phải thấy các tuỳ chọn kỹ thuật.
                        -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            FontSize="16"
                            Header="Tuỳ chỉnh nâng cao"
                            IsExpanded="False">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource HelpTextStyle}" Text="Chỉ dùng khi muốn tự chọn. Kéo thanh hoặc sửa số sẽ bỏ chọn 3 mục ở trên." />
                                <Slider
                                    FontSize="16"
                                    Header="Chất lượng ảnh (1–100)"
                                    Maximum="100"
                                    Minimum="1"
                                    StepFrequency="1"
                                    Value="{x:Bind ViewModel.Export.CustomQuality, Mode=TwoWay}" />
                                <!--  Để trống thì Value = NaN, ViewModel hiểu là "giữ nguyên chiều rộng".  -->
                                <NumberBox
                                    FontSize="16"
                                    Header="Chiều rộng tối đa (điểm ảnh)"
                                    Maximum="20000"
                                    Minimum="64"
                                    PlaceholderText="Để trống: giữ nguyên"
                                    SmallChange="128"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.Export.CustomMaxWidth, Mode=TwoWay}" />
                                <TextBlock
                                    Style="{StaticResource ErrorTextStyle}"
                                    Text="{x:Bind ViewModel.Export.ValidationMessage, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.HasValidationError), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!--  Hàng dưới: thẻ kết quả + nút Lưu (hoặc thẻ đang lưu)  -->
                <StackPanel Grid.Row="1" Spacing="12">

                    <!--  Lưu xong: thẻ xanh  -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.IsResultSuccess), Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Glyph="&#xE73E;" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind ViewModel.Export.ResultTitle, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Export.ResultMessage, Mode=OneWay}" TextWrapping="Wrap" />
                            <Button
                                MinHeight="44"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.Export.OpenResultCommand}"
                                Content="Mở file PDF"
                                FontSize="16"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.Export.OpenFolderCommand}"
                                Content="Mở thư mục chứa file" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.NewDocumentCommand}"
                                Content="Làm file mới" />
                        </StackPanel>
                    </Border>

                    <!--  Huỷ hoặc lỗi: thẻ thông báo rõ ràng ở cùng chỗ  -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.IsResultProblem), Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind ViewModel.Export.ResultTitle, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.Export.ResultMessage, Mode=OneWay}" TextWrapping="Wrap" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.Export.DismissResultCommand}"
                                Content="Đã hiểu" />
                        </StackPanel>
                    </Border>

                    <!--  Nút Lưu; Ctrl+E gọi cùng command  -->
                    <StackPanel Spacing="8" Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.IsNotExporting), Mode=OneWay}">
                        <Button
                            MinHeight="56"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.Export.ExportCommand}"
                            FontSize="19"
                            Style="{StaticResource AccentButtonStyle}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="E" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <SymbolIcon Symbol="Save" />
                                <TextBlock Text="{x:Bind ViewModel.Export.SaveButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource HelpTextStyle}"
                            Text="{x:Bind ViewModel.Export.SaveHintText, Mode=OneWay}"
                            TextAlignment="Center" />
                    </StackPanel>

                    <!--  Đang lưu: thay nút Lưu bằng thẻ tiến độ + nút huỷ  -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.Export.IsExporting), Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind ViewModel.Export.ProgressText, Mode=OneWay}" />
                            <ProgressBar
                                AutomationProperties.Name="Tiến độ lưu"
                                Maximum="100"
                                Value="{x:Bind ViewModel.Export.Progress, Mode=OneWay}" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.Export.CancelCommand}"
                                Content="Huỷ, không lưu nữa" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
