<?xml version="1.0" encoding="utf-8" ?>
<!--
    ContentDialog: hộp thoại modal của WinUI, có sẵn các nút Primary/Close ở dưới.
    IsPrimaryButtonEnabled bind vào IsValid nên nút "Xuất" tự mờ khi tuỳ chọn chưa hợp lệ.
-->
<ContentDialog
    x:Class="ImageMerger.Views.ExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:ImageMerger.Helpers"
    Title="Xuất PDF"
    CloseButtonText="Huỷ"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsValid, Mode=OneWay}"
    PrimaryButtonText="Xuất"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="420" Spacing="16">

        <!--  ComboBox: danh sách thả xuống. Thứ tự item khớp enum CompressionPreset.  -->
        <StackPanel Spacing="4">
            <ComboBox
                MinWidth="240"
                Header="Mức nén"
                SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}">
                <x:String>Gốc</x:String>
                <x:String>Cân bằng (khuyên dùng)</x:String>
                <x:String>Nhỏ gọn</x:String>
                <x:String>Tuỳ chỉnh</x:String>
            </ComboBox>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.PresetSummary, Mode=OneWay}" />
        </StackPanel>

        <!--  Slider: kéo để chọn số trong khoảng. Chỉ hiện với Tuỳ chỉnh.  -->
        <Slider
            Header="Chất lượng"
            Maximum="100"
            Minimum="1"
            StepFrequency="1"
            Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.IsCustom), Mode=OneWay}"
            Value="{x:Bind ViewModel.CustomQuality, Mode=TwoWay}" />

        <!--
            NumberBox: ô nhập số có nút tăng/giảm. Minimum/Maximum tự kẹp giá trị khi người dùng nhập xong.
            Để trống thì Value = NaN, ViewModel hiểu là "giữ nguyên chiều rộng".
        -->
        <NumberBox
            Header="Chiều rộng tối đa (px)"
            Maximum="20000"
            Minimum="64"
            PlaceholderText="Để trống: giữ nguyên"
            SmallChange="128"
            SpinButtonPlacementMode="Compact"
            Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.IsCustom), Mode=OneWay}"
            Value="{x:Bind ViewModel.CustomMaxWidth, Mode=TwoWay}" />

        <TextBlock
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind helpers:XamlFunctions.ToVisibility(ViewModel.HasValidationError), Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
